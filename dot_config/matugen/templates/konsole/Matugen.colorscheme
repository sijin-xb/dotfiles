# ===========================================================================
#  Konsole 配色方案 —— matugen 生成，不要手改
#  模板：~/.config/matugen/templates/konsole/Matugen.colorscheme
#
#  角色选择规则与 kitty 模板一致（那边有完整说明与实测数据）：
#  · 暗色方案下不可用 *_container / surface_container_lowest —— tone 10–30
#    的暗色，当 ANSI 文字色对比度只有 1.0–2.0。
#  · Konsole 的 Color 值是十进制 "R,G,B"，**不能**用 matugen 的 lighten
#    过滤器（它输出 hex），所以 Intense 行改用 tone-90 的 *_fixed 家族
#    与 on_* 角色来表达「更亮」。
#
#  选中本方案靠三层：本文件 + Matugen.profile 的 ColorScheme +
#  konsolerc 的 DefaultProfile（由 matugen 的 post_hook 写）。
# ===========================================================================

[Background]
Color={{colors.background.default.red}},{{colors.background.default.green}},{{colors.background.default.blue}}

[BackgroundIntense]
Color={{colors.surface_container_low.default.red}},{{colors.surface_container_low.default.green}},{{colors.surface_container_low.default.blue}}

[BackgroundFaint]
Color={{colors.surface_container_highest.default.red}},{{colors.surface_container_highest.default.green}},{{colors.surface_container_highest.default.blue}}

[Foreground]
Color={{colors.on_background.default.red}},{{colors.on_background.default.green}},{{colors.on_background.default.blue}}

[ForegroundIntense]
Color={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}

[ForegroundFaint]
Color={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}

[Color0]
Color={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}

[Color0Intense]
Color={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}

[Color0Faint]
Color={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}

[Color1]
Color={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}

[Color1Intense]
Color={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}

[Color1Faint]
Color={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}

[Color2]
Color={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}

[Color2Intense]
Color={{colors.tertiary_fixed.default.red}},{{colors.tertiary_fixed.default.green}},{{colors.tertiary_fixed.default.blue}}

[Color2Faint]
Color={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}

[Color3]
Color={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

[Color3Intense]
Color={{colors.secondary_fixed.default.red}},{{colors.secondary_fixed.default.green}},{{colors.secondary_fixed.default.blue}}

[Color3Faint]
Color={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

[Color4]
Color={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}

[Color4Intense]
Color={{colors.primary_fixed.default.red}},{{colors.primary_fixed.default.green}},{{colors.primary_fixed.default.blue}}

[Color4Faint]
Color={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}

[Color5]
Color={{colors.tertiary_fixed.default.red}},{{colors.tertiary_fixed.default.green}},{{colors.tertiary_fixed.default.blue}}

[Color5Intense]
Color={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}

[Color5Faint]
Color={{colors.tertiary_fixed.default.red}},{{colors.tertiary_fixed.default.green}},{{colors.tertiary_fixed.default.blue}}

[Color6]
Color={{colors.primary_fixed.default.red}},{{colors.primary_fixed.default.green}},{{colors.primary_fixed.default.blue}}

[Color6Intense]
Color={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}

[Color6Faint]
Color={{colors.primary_fixed.default.red}},{{colors.primary_fixed.default.green}},{{colors.primary_fixed.default.blue}}

[Color7]
Color={{colors.on_background.default.red}},{{colors.on_background.default.green}},{{colors.on_background.default.blue}}

[Color7Intense]
Color={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}

[Color7Faint]
Color={{colors.on_background.default.red}},{{colors.on_background.default.green}},{{colors.on_background.default.blue}}

[General]
Description=Matugen
Opacity=1.0
Blur=false
