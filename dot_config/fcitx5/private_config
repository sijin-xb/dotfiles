[Behavior]
# 2026-10-02 显式打开这两项，解决「每开一个新窗口输入法都是中文」。
#
# 成因：Wayland 下客户端窗口是异步创建的，fcitx5 的输入状态会在窗口之间被动
# 继承 —— 在浏览器里处于中文时，新开的窗口也继承中文。默认值
# ShareInputState=No 并不阻止这种继承。
#
# ShareInputState=Program 让状态按「程序」隔离：浏览器保持中文、终端保持英文，
# 互不污染。这是 omarchy + rime-ice 场景下验证过的取值。
ShareInputState=Program

# 新程序启动时输入法处于「未激活」状态，按键直接交给 XKB —— 也就是纯英文。
# 与 profile 里的 DefaultIM=keyboard-us 配套：即使激活了也是英文起步。
ActiveByDefault=False

