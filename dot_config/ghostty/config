# ghostty 配置
#
# 本体尚未安装（装包名 ghostty），先把终端相关设置备好，装完即生效。
#
# 不画窗口装饰（标题栏 + 边框）。tiling WM 自己管窗口边界，CSD 是多余的
# 一条横杠，还吃掉几十像素行高。
#   none = 全部关掉；auto（默认）= 按桌面环境自选；client / server 自 1.1.0 起
#   另有布尔简写：false ≡ none，true ≡ auto。
# 与 kitty 的 hide_window_decorations、alacritty 的 decorations="None" 对齐。
window-decoration = none

# 配色待接：matugen 模板 ~/.config/matugen/templates/ghostty-colors.conf 已经
# 写好，但 config.toml 里还没有 [templates.ghostty] 引用它（孤儿模板）。
# 等 ghostty 装好、模板接进 config.toml 之后，在这里加一行 config-file
# 指向生成的配色文件即可。
