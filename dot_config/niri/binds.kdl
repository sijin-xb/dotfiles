//这个文件是快捷键设置

binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name
    // in the end. To find an XKB name for a particular key, you may use a program
    // like wev.
    //
    // "Mod" is a special modifier equal to Super when running on a TTY, and to Alt
    // when running as a winit window.
    // // Most actions that you can bind here can also be invoked programmatically with
    // `niri msg action do-something`.
    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.

    // 显示快捷键教程
    Super+Slash hotkey-overlay-title="快捷键教程 Keybind tutorial" { spawn "~/.config/niri/scripts/niri-binds"; }


    // 壁纸已交给 DMS：这里开 DMS 仪表盘的壁纸页（原来是 waypaper）
    Mod+Alt+W hotkey-overlay-title="切换壁纸 Change wallpaper" { spawn "dms" "ipc" "call" "dankdash" "wallpaper"; }
    Mod+F10 hotkey-overlay-title="随机切换壁纸 Random wallpaper" { spawn "dms" "ipc" "call" "wallpaper" "next"; }
    Mod+Shift+F10 hotkey-overlay-title="随机下载动漫壁纸 Random download anime wallpaper" {spawn "~/.config/scripts/random-anime-wallpaper.sh";}
    Mod+F1 hotkey-overlay-title="开关输入法 Toggle fcitx" {spawn-sh "pkill fcitx5 || fcitx5 -d";}
    // F2/F3/F4/Shift+F4 原为 waybar 相关，waybar 已停用故整段删除；
    // 开关任务栏改用 Super+J（见 dms/binds.kdl）。
    // Mod+F5 / Mod+F8 已删（2026-10-10）：quicksave / quickload 这两个可执行文件
    // 本机不存在（~/.local/bin、fish 函数、pacman 包都没有），按下去只是 spawn 失败。
    // 而且 niri 的 spawn 不走 shell，就算写成 fish 函数也调不到。
    // 将来装了（或自己写了脚本放进 ~/.local/bin）再把这两行配回来。
    // 截图翻译 —— 2026-09-23 注释掉：wl-wordlens 这个可执行文件本机并不存在
    // （flatpak / pacman / .desktop / 数据目录里都没有），按下去只是 spawn 失败，
    // 什么都不会发生。将来装上 wordlens 后把这两行取消注释即可。
    // rule.kdl 里配套的 match app-id="com.wordlens.app" 也一并注掉了。
    //Mod+F11 hotkey-overlay-title="截图翻译 Screenshot Translator" {spawn "wl-wordlens";}
    //Mod+Shift+T hotkey-overlay-title="截图翻译 Screenshot Translator" {spawn "wl-wordlens";}
    // Mod+F12（grim - | wl-copy 截所有显示器）已删（2026-10-10）：
    // 被 Mod+Alt+Ctrl+Shift+A 的 `dms screenshot all` 取代，且原来那条只复制不落盘。
    // Mod+Ctrl+Shift+Alt+B（播放 Bad Apple）已删（2026-10-10）：bad-apple 不存在。

    // 以下功能需要安装nirius并启动niriusd
    Mod+Ctrl+G hotkey-overlay-title="切换工作区时自动跟随 Follow when switch workspaces" {spawn "nirius" "toggle-follow-mode" ;} 
    Mod+Shift+Q hotkey-overlay-title="快速聚焦到QQ Quick focus QQ" {spawn "nirius" "focus" "--app-id" "QQ" ;} 
    Mod+Shift+O hotkey-overlay-title="快速聚焦到OpenCode Quick focus OpenCode" {spawn "nirius" "focus" "--app-id" "opencode" ;} 
    // Mod+Shift+W（快速聚焦微信）已删（2026-10-10）：本机没装微信，
    // 不存在 app-id 为 wechat 的窗口，nirius focus 只会非零退出。
    // QQ 和 OpenCode 那两条保留（两个程序都在，且 QQ 正在跑）。 

    //niri-shorin-fork（2026-09-26 换回该 fork 后恢复）
    Mod+Alt+WheelScrollUp hotkey-overlay-title="滚轮放大屏幕 magnifier"  { adjust-magnifier-zoom 0.2; }
    Mod+Alt+WheelScrollDown hotkey-overlay-title="滚轮缩小屏幕 magnifier" { adjust-magnifier-zoom -0.2; }
    Mod+Shift+Z  hotkey-overlay-title="切换屏幕缩放效果 magnifier" { toggle-magnifier; }

    // 临时开一个浮动终端
    Mod+Alt+O hotkey-overlay-title="AI助手 opencode agent" { spawn "kitty" "--class" "opencode" "-e" "opencode"; }        
    

    // Suggested binds for running programs: terminal, app launcher, screen locker.
    Mod+T hotkey-overlay-title="共享终端 Terminal" { spawn "kitty" "--single-instance"; }
    Mod+return hotkey-overlay-title="独立终端 Terminal" { spawn "kitty"; }
    // 文档管理器。如果有thunar的话会优先打开thunar，没有的话会打开nautilus，不要问我为什么（）
    Mod+Alt+E hotkey-overlay-title="文档管理器 File manager" {spawn "env" "GSK_RENDERER=gl" "nautilus" "--new-window";}
    // Mod+Z 原为 fuzzel 启动器，DMS 自带启动器（轻触 Super / Super+Space）故删除。
    // 锁屏
    Mod+Alt+L hotkey-overlay-title="锁屏 Lock screen" { spawn-sh "hyprlock -c ~/.config/niri/hyprlock.conf"; } 
    Mod+P hotkey-overlay-title="提取窗口信息 Pick information" { spawn "~/.config/niri/scripts/niri-pick" "focus"; }
    //Mod+Alt+V  hotkey-overlay-title="剪贴板 Clipboard" {spawn-sh "copyq toggle || ~/.local/bin/clipse-gui || kitty --class clipse --single-instance -e clipse";}
    // 这是我自己的剪贴板程序，对应aur包cliphist-tui-git
    Mod+Alt+V hotkey-overlay-title="剪贴板 Clipboard" repeat=false {spawn-sh "kitty --single-instance --class cliphist-tui -e cliphist-tui";} // Use spawn-sh to run a shell command. Do this if you need pipes, multiple commands, etc.
    // Note: the entire command goes as a single argument. It's passed verbatim to `sh -c`.
    // Super+Alt+S（屏幕阅读器 orca 开关）已删（2026-10-10）：orca 未安装，
    // pkill 找不到进程，exec orca 直接 command not found。
    //Super+Alt+V {spawn "copyq" "toggle";}
    // Example volume keys mappings for PipeWire & WirePlumber.
    // The allow-when-locked=true property makes them work even when the session is locked.
    // Using spawn-sh allows to pass multiple arguments together with the command.
    // 调节音量

    // Example brightness key mappings for brightnessctl.
    // You can use regular spawn with multiple arguments too (to avsoid going through "sh"),
    // but you need to manually put each argument in separate "" quotes.
    // 调节屏幕亮度

    // Open/close the Overview: a zoomed-out view of workspaces and windows.
    // You can also move the mouse into the top-left hot corner,
    // or do a four-finger swipe up on a touchpad.
    // 切换overview总览
    // 让位给 DMS：Hyprland 里 Super+O 是左侧栏（总览由 Super+Tab 承担，已绑）
    //Mod+O hotkey-overlay-title="切换总览界面 toggle overview" repeat=false { toggle-overview; }
    // 轻触 Super 已归 DMS 启动器（dms/binds.kdl）；niri 内建的
    // 「轻触 Mod 开网格总览」也在 config.kdl 里用 default-mod-action false 关掉了。
    // 网格总览改到 Super+Shift+Space（见 binds-hyprland-migrated.kdl）
    //Mod hotkey-overlay-title="切换网格总览界面 toggle grid overview" repeat=false { toggle-grid-overview; }
    // 关闭聚焦窗口
    Alt+Shift+F4  hotkey-overlay-title="强制杀死窗口以及关联进程 Force kill -9 a window tree" repeat=false { spawn "~/.config/niri/scripts/niri-force-kill-window" "-f"; }

    // mod+鼠标中键 关闭窗口
    Mod+MouseMiddle  hotkey-overlay-title="中键关闭窗口 Close window (middle click)" { close-window; }

    // 下面的快捷键看着很多很复杂，其实并不难记。
    // ── 方向键方案（2026-10-10 归一）────────────────────────────
    // 原来同一动作绑了 wasd / hjkl / 箭头 三套（95 条里的大头），现只留箭头一套：
    //   Mod+方向        切换聚焦（左右切列，上下切列内窗口）
    //   Mod+Shift+方向  移动窗口 / 列
    //   Mod+Ctrl+左右   切换工作区（与 Hyprland 同键，见 binds-hyprland-migrated.kdl）
    //   Mod+Ctrl+上下   无绑定（原 Mod+Ctrl+Up 是 move-window-up，与 Mod+Shift+Up 重复）
    //   Mod+H/J/K/L 及其 Ctrl 组合、Mod+Ctrl+A/D 已删。
    // 滚轮那几组保留（Mod / Mod+Shift / Mod+Ctrl+Shift+WheelScroll），见下方。
    // 想恢复某一套：wasd 对应 A/S/D/W、hjkl 对应 H/J/K/L，直接照抄箭头那几行的动作名。
    
    // Alternative commands that move across workspaces when reaching
    // the first or last window in a column.
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    // 切换到第一个colume
    Mod+Home hotkey-overlay-title="聚焦第一列 Focus first column" { focus-column-first; }
    // 切换到最后一个colume
    Mod+End  hotkey-overlay-title="聚焦最后一列 Focus last column" { focus-column-last; }
    // 移动colume到第一个
    Mod+Ctrl+Home hotkey-overlay-title="整列移到最前 Move column to first" { move-column-to-first; }
    // 移动colume到最后一个
    Mod+Ctrl+End  hotkey-overlay-title="整列移到最后 Move column to last" { move-column-to-last; }

    // ── 跨显示器绑定已全部删除（2026-10-10）──────────────────────
    // 原因：本机只有一个输出（HDMI-A-1），下面这 27 条按下去毫无反应；
    // 而且同一个动作原样绑了 箭头 / HJKL / ASWD 三套，纯冗余。
    // 删掉的是：focus-monitor-{left,down,up}（原本就没绑 right，方向组本身不完整）
    //          move-column-to-monitor-{left,right,up,down}
    //          move-workspace-to-monitor-{left,right,up,down}
    // 将来接第二台显示器时，照下面这些动作名配回 Mod+Shift+方向 /
    // Mod+Shift+Ctrl+方向 / Mod+Shift+Alt+方向 即可：
    //   focus-monitor-{left,right,up,down}
    //   move-column-to-monitor-{left,right,up,down}
    //   move-workspace-to-monitor-{left,right,up,down}
    // 注：单窗口版本 move-window-to-monitor-* 当时就没启用，同样按上表恢复。
    
    // 上下切换工作区
    Mod+Ctrl+Page_Down hotkey-overlay-title="整列移到下个工作区 Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up hotkey-overlay-title="整列移到上个工作区 Move column to prev workspace"  { move-column-to-workspace-up; }

    // You can bind mouse wheel scroll ticks using the following syntax.
    // These binds will change direction based on the natural-scroll setting.
    //
    // To avoid scrolling through workspaces really fast, you can use
    // the cooldown-ms property. The bind will be rate-limited to this value.
    // You can set a cooldown on any bind, but it's most useful for the wheel.

    // mod+shitf+滚轮上下切换工作区
    Mod+Shift+WheelScrollDown  hotkey-overlay-title="切换工作区 Change workspaces"    cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title="切换工作区 Change workspaces" cooldown-ms=150 { focus-workspace-up; }
    //再加上ctrl移动窗口
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title="滚轮把整列移到下个工作区 Move column to next workspace" cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   hotkey-overlay-title="滚轮把整列移到上个工作区 Move column to prev workspace" cooldown-ms=150 { move-column-to-workspace-up; }

    // 如果滚轮支持左右的话这里可以设置切换聚焦和移动窗口
    //Mod+WheelScrollRight      { focus-column-right; }
    //Mod+WheelScrollLeft       { focus-column-left; }
    //Mod+Ctrl+WheelScrollRight { move-column-right; }
    //Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.

    // mod+滚轮上下 左右切换聚焦
    Mod+WheelScrollDown   hotkey-overlay-title="滚轮切换聚焦 Change focus with wheel"   { focus-column-right; }
    Mod+WheelScrollUp        hotkey-overlay-title="滚轮切换聚焦 Change focus with wheel" { focus-column-left; }
    // 再加上ctrl移动colume
    Mod+Ctrl+WheelScrollDown hotkey-overlay-title="滚轮右移整列 Move column right with wheel" { move-column-right; }
    Mod+Ctrl+WheelScrollUp   hotkey-overlay-title="滚轮左移整列 Move column left with wheel" { move-column-left; }

    // Similarly, you can bind touchpad scroll "ticks".
    // Touchpad scrolling is continuous, so for these binds it is split into
    // discrete intervals.
    // These binds are also affected by touchpad's natural-scroll, so these
    // example binds are "inverted", since we have natural-scroll enabled for
    // touchpads by default.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // You can refer to workspaces by index. However, keep in mind that
    // niri is a dynamic workspace system, so these commands are kind of
    // "best effort". Trying to refer to a workspace index bigger than
    // the current workspace count will instead refer to the bottommost
    // (empty) workspace.
    //
    // For example, with 2 workspaces + 1 empty, indices 3, 4, 5 and so on
    // will all refer to the 3rd workspace.
    // Mod+Ctrl+1..9（把整列移到第 N 个工作区）已删（2026-10-10）：
    // 本机只用 2 个工作区，数字直达用不上；整列移到相邻工作区保留在
    // Mod+Ctrl+Page_Up/Down 和 Mod+Ctrl+Shift+滚轮。
    // 注意 Mod+1..9/0（切换工作区）在 binds-hyprland-migrated.kdl 里，没动。

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // Switches focus between the current and the previous workspace.
    //Mod+Tab { focus-workspace-previous; }
    
    // The following binds move the focused window in and out of a column.
    // If the window is alone, they will consume it into the nearby column to the side.
    // If the window is already in a column, they will expel it out.

    // mod+左右方括号 移动窗口（不是移动colume，是允许移动到另一个colume的窗口移动）
    Mod+BracketLeft  hotkey-overlay-title="向左移动窗口 Move window to left between columes" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="向右移动窗口 Move window to right between columes" { consume-or-expel-window-right; }
    // Mod+A / Mod+Shift+A / Mod+Shift+D 已删（2026-10-10）：wasd 那套的重复键位，
    // 分别与 Mod+BracketLeft、Mod+Comma、Mod+Period 同动作（后两条在
    // binds-hyprland-migrated.kdl 里，保留）。原来只有 Mod+A 带标题、能被速查表
    // 列出，标题已挪到 Mod+BracketLeft 上。
    // 开启colume的标签页模式（同一个colume中的窗口会以类似浏览器标签页的形式堆叠）
    Mod+MouseForward hotkey-overlay-title="鼠标侧键聚焦上一个窗口 Focus window up (mouse side button)" { focus-window-up; }
    Mod+MouseBack    hotkey-overlay-title="鼠标侧键聚焦下一个窗口 Focus window down (mouse side button)" { focus-window-down; }
    
    // 按照预设切换窗口宽度
    Mod+R  hotkey-overlay-title="按预设切换宽度 Switch width " { switch-preset-column-width; }
    // Cycling through the presets in reverse order is also possible.
    // Mod+R { switch-preset-column-width-back; }

    // 按照预设切换窗口高度
    Mod+Ctrl+R hotkey-overlay-title="重置窗口高度 Reset window height" { reset-window-height; }

    Mod+Ctrl+F hotkey-overlay-title="整列撑满剩余宽度 Expand column to available width" { expand-column-to-available-width; }

    // 居中当前聚焦的colume
    Mod+Ctrl+C hotkey-overlay-title="居中可见列 Center visible columns" { center-visible-columns; }

    // Finer width adjustments.
    // This command can also:
    // * set width in pixels: "1000"
    // * adjust width in pixels: "-5" or "+5"
    // * set width as a percentage of screen width: "25%"
    // * adjust width as a percentage of screen width: "-10%" or "+10%"
    // Pixel sizes use logical, or scaled, pixels. I.e. on an output with scale 2.0,
    // set-column-width "100" will make the column occupy 200 physical screen pixels.

    // mod+加减号调整窗口宽度

    // Finer height adjustments when in column with other windows.
    // mod+shift+加减号调整窗口高度
    Mod+Shift+Minus hotkey-overlay-title="窗口高度-5% Shrink window height" { set-window-height "-5%"; }
    Mod+Shift+Equal hotkey-overlay-title="窗口高度+5% Grow window height" { set-window-height "+5%"; }

    // Move the focused window between the floating and the tiling layout.
    // 切换浮动模式
    Mod+Shift+V hotkey-overlay-title="浮动/平铺切换 Toggle floating" { switch-focus-between-floating-and-tiling; }

    Mod+Alt+N hotkey-overlay-title="浮动/平铺切换 Toggle floating" { switch-focus-between-floating-and-tiling; }

    // Toggle tabbed column display mode.
    // Windows in this column will appear as vertical tabs,
    // rather than stacked on top of each other.
    

    // Actions to switch layouts.
    // Note: if you uncomment these, make sure you do NOT have
    // a matching layout switch hotkey configured in xkb options above.
    // Having both at once on the same hotkey will break the switching,
    // since it will switch twice upon pressing the hotkey (once by xkb, once by niri).
    //Mod+Shift+X       { switch-layout "next"; }
    //Mod+Shift+Z { switch-layout "prev"; }

    // ── 截图（2026-10-10 全换成 DMS 的 `dms screenshot`）──────────────
    // 为什么换：原来 9 个键压着三个后端（niri 内置 6 条、grim|wl-copy 1 条、
    // grim+slurp 2 条，后两条见 binds-hyprland-migrated.kdl 的说明），而 DMS
    // 这套把三者能力全覆盖，还多出 last（重拍上次选区）与 scroll（滚动长图）。
    // 落盘目录：环境变量 DMS_SCREENSHOT_DIR 统一到
    //   ~/Pictures/Screenshots/Niri-screenshots/
    //   （见 config.kdl 的 environment 块 + ~/.config/environment.d/dms-screenshot.conf）
    // DMS 自己的文件名是 screenshot_<日期>_<时间>.png，与 niri 内置的命名不同。
    // 快门音效：截图命令返回后再给 screenshot-sound.sh 发 USR1（沿用原做法）。
    // 另外两点：last 在没有上次选区时会自动回退到交互选区，不会报错；
    //           想要「松开鼠标即截」给区域那条加 --no-confirm 即可。
    Print            hotkey-overlay-title="区域截图 Region screenshot"       { spawn-sh "dms screenshot && pkill -f -USR1 screenshot-sound.sh"; }
    Shift+Print      hotkey-overlay-title="重拍上次区域 Last region"         { spawn-sh "dms screenshot last && pkill -f -USR1 screenshot-sound.sh"; }
    Ctrl+Print       hotkey-overlay-title="当前输出整屏 Full screen"         { spawn-sh "dms screenshot full && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+Alt+A        hotkey-overlay-title="滚动长图 Scrolling capture"       { spawn-sh "dms screenshot scroll && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+Alt+Ctrl+A   hotkey-overlay-title="聚焦窗口 Focus-window screenshot" { spawn-sh "dms screenshot window && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+Alt+Ctrl+Shift+A hotkey-overlay-title="所有输出拼接 All outputs"     { spawn-sh "dms screenshot all && pkill -f -USR1 screenshot-sound.sh"; }

    //Mod+Shift+S { spawn "~/.config/niri/scripts/satty-screenshot.sh";}
    Mod+Escape hotkey-overlay-title="开关快捷键抑制 Toggle shortcuts inhibit" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // The quit action will show a confirmation dialog to avoid accidental exits.
    Mod+Shift+E hotkey-overlay-title="退出niri Quit niri" { quit; }
}

    // ============================================================
    // 归档说明（2026-10-10）
    // 这里原有约 110 行「迁移前 niri 原有绑定」的注释存档，已删除 ——
    // 它们引用的组件（waybar / cava / fuzzel / swayosd / thunar / satty /
    // matugen-select-type.sh）本机都已移除或从未安装，留着只是噪音。
    // 需要回查时看 git 历史：git log -p -- dot_config/niri/binds.kdl
    // 当前生效的键位 = 本文件 + binds-hyprland-migrated.kdl + dms/binds.kdl。
    // ============================================================



