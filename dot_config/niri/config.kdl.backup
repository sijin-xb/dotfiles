// 截图保存位置
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d_%H-%M-%S.png"

// 环境变量
environment {
    // 语言与输入法设置
    LANGUAGE "zh_CN.UTF-8"
    LANG "zh_CN.UTF-8"
    LC_CTYPE "en_US.UTF-8"
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    GTK_THEME "Adwaita:dark"
    // 光标设置
    XCURSOR_THEME "Bibata-Modern-Amber"
    XCURSOR_SIZE "24"

    // --- 主题修复核心区 ---
    // 强制指定 GTK 使用深色主题
    GTK_THEME "Adwaita:dark"
    // 告诉新版 GTK4 应用不要去问 Portal 颜色，直接听我的
    ADW_DISABLE_PORTAL "1"

    // QT 主题适配 (使用 qt5ct 独立管理，不再依赖不稳定的 GTK 映射)
    QT_QPA_PLATFORMTHEME "qt5ct"
    QT_QPA_PLATFORMTHEME_QT6 "qt5ct"

    // 界面图标
    QS_ICON_THEME "WhiteSur"
    EDITOR "nvim"
    VISUAL "nvim"
}

input {
    keyboard {
        xkb {
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed -0.15
        accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// --- 自动启动 ---

// 1. 启动 Shell (Noctalia)
spawn-sh-at-startup "qs -c noctalia-shell"

// 2. 强制写入深色模式协议 (这是解决 GTK4 应用变白的关键)
spawn-sh-at-startup "dconf write /org/gnome/desktop/interface/color-scheme \"'prefer-dark'\""

// 3. 身份验证代理
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// 4. 环境同步 (重点：确保 Portal 知道我们要深色)
spawn-sh-at-startup "dbus-update-activation-environment --all && systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"

// 5. 显式启动 Portal 服务
spawn-at-startup "/usr/lib/xdg-desktop-portal-gnome"

// 6. 其他基础服务
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
spawn-at-startup "fcitx5"
spawn-at-startup "~/.config/niri/scripts/screenshot-sound.sh"
spawn-at-startup "xhost" "+si:localuser:root"
spawn-at-startup "systemctl" "--user" "start" "clipsync"

// --- 界面设置 ---
hotkey-overlay {
    skip-at-startup
}

// 隐藏窗口标题栏
prefer-no-csd

// --- 包含子配置文件 ---
include "layout.kdl"
include "animations.kdl"
include "binds.kdl"
include "supertab.kdl"
include "windowrules.kdl"
include "cursor.kdl"
include "outputs.kdl"

// 引入 Noctalia 套件配置
include "./noctalia.kdl"

