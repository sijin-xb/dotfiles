// =====================================================================
// 1. 全局模糊效果配置 (渲染质量)
// =====================================================================
blur {
    // 渲染次数，越多越油润。3-5 是平衡点。
    passes 3
    // 提高偏移让模糊半径更明显，更接近毛玻璃
    offset 2
    // 轻微提饱和，避免背景发灰
    saturation 2
    // 噪点：极其重要，开启模糊后能防止暗色区域出现色阶断层
    noise 0.04
}

// =====================================================================
// 2. 全局窗口默认规则
// =====================================================================
window-rule {
    // 基础外观
    geometry-corner-radius 8
    clip-to-geometry true
    // 全局透明度再明显一点，让所有窗口都有可见玻璃感
    opacity 0.90
    draw-border-with-background false

    // 全局改用常规 blur，视觉上比 xray 更明显。
    background-effect {
        blur true
        xray false
    }
}

// 浮动窗口更适合使用常规 blur，而不是 xray blur。
// 再加一点很轻的透明和阴影，视觉上更接近毛玻璃卡片。
window-rule {
    match is-floating=true

    // 浮动窗更明显一点，做成玻璃卡片感
    opacity 0.90

    background-effect {
        blur true
        xray false
    }

    shadow {
        on
        softness 32
        spread 2
        offset x=0 y=10
        draw-behind-window true
        color "#00000055"
    }
}

// =====================================================================
// 3. 图层规则 (Noctalia Shell)
// =====================================================================
layer-rule {
    match namespace="^noctalia-overview*"
    // 配合模糊效果，使 Overview 界面具有深度的毛玻璃感
    place-within-backdrop true
}

// =====================================================================
// 4. 视频/图片查看器：必须完全关闭效果，防止色偏与性能损耗
// =====================================================================
window-rule {
    match title="图片查看器"
    match title="画中画"
    match title="视频播放器"
    match app-id="mpv"
    match app-id="celluloid"
    match app-id="haruna"
    match app-id="imv"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"

    opacity 1.0

    // 显式关闭模糊与 Xray
    background-effect {
        xray false
        blur false
    }
}

// =====================================================================
// 5. 自动浮动与特定尺寸应用
// =====================================================================

// 翻译工具 (Dialect) - 已修复报错
window-rule {
    match app-id="app.drey.Dialect"
    open-floating true
    default-column-width { fixed 650; }
    default-window-height { fixed 500; }
    open-on-output "focused"
    opacity 0.95
}

// 剪贴板工具
window-rule {
    match app-id="shorinclip"
    match app-id="clipse"
    default-column-width { fixed 625; }
    default-window-height { fixed 700; }
    open-floating true
    default-floating-position x=0 y=18 relative-to="top"
}

// 常用工具类
window-rule {
    match app-id="com.gabm.satty"
    match app-id="nm-connection-editor"
    match app-id="niri-quick-switch"
    match app-id="flameshot"
    match app-id="com.github.hluk.copyq"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="waypaper"
    match app-id="niri-hotkey-menu"
    match app-id="zenity"
    open-floating true
}

window-rule {
    match title="OCR 翻译结果"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 640; }
    default-floating-position x=20 y=20 relative-to="top"
}

// 快速终端
window-rule {
    match app-id="quickterminal"
    match app-id="floating-term"
    open-floating true
    default-floating-position x=20 y=20 relative-to="top"
}

// QQ 浮动窗口
window-rule {
    match app-id="QQ"
    open-floating true
    default-column-width { fixed 980; }
    default-window-height { fixed 820; }
}

// Steam 适配
window-rule {
    match app-id="steam" title="Friends List"
    match app-id="steam" title="好友列表"
    default-column-width { proportion 0.20; }
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// =====================================================================
// 6. 终端与系统适配
// =====================================================================

// GNOME 圆角适配
window-rule {
    match app-id=r#"^org\.gnome\."#
    geometry-corner-radius 12
}

// 终端边框处理
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

// Waydroid 与 全屏覆盖
window-rule {
    match title="gsr ui"
    match app-id="waydroid"
    open-fullscreen true
    focus-ring { off; }
    shadow { off; }
}
