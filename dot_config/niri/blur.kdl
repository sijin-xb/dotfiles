
blur {
    passes 2
    offset 2
    noise 0.02
    saturation 1.3
}


window-rule {
    opacity 0.85
    background-effect {
        blur true
        xray true
    }
}

// 浮动窗口同样透出预模糊背景
window-rule {
    match is-floating=true
    background-effect {
        xray true
        blur true
    }
}

// fuzzle 启动器的 layer 规则
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 8
    background-effect {
        xray false
        blur true
    }
}

// 文件管理器的弹出窗口
window-rule {
    match app-id="thunar"
    match app-id="Nautilus"
    opacity 0.88

    popups {
        geometry-corner-radius 15
        opacity 0.88
        background-effect {
            blur true
            xray false
        }
    }
}

window-rule {
    match title="图片查看器"
    match title="画中画"
    match title="图片和视频"
    match title="视频播放器"
    opacity 1.0
}
window-rule {
    match app-id="mpv"
    match app-id="celluloid"
    match app-id="virt-manager"
    opacity 1.0
}
window-rule {
    match app-id="org.gnome.Loupe"
    opacity 1.0
}
// imv 是纯看图窗口，半透明会让图片颜色失真，也不该透出模糊背景。
// 它浮动打开，会吃到上面 is-floating 那条的 blur，这里一并关掉。
window-rule {
    match app-id="imv"
    opacity 1.0
    background-effect {
        xray false
        blur false
    }
}

// showmethekey 的按键浮层
window-rule {
    match app-id="one.alynx.showmethekey"
    opacity 1.0
    background-effect {
        xray false
        blur false
    }
}
// --- NIRI BLUR END ---
