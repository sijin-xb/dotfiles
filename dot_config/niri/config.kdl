// 截图保存位置
screenshot-path "/home/xibie/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d_%H-%M-%S.png"
 
environment {
    // 语言与输入法
    LANGUAGE "zh_CN.UTF-8"
    LANG "zh_CN.UTF-8"
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    LC_ALL "zh_CN.UTF-8"
    FREETYPE_PROPERTIES "truetype:interpreter-version=38"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // --- 主题修复核心区 ---
    GTK_ICON_THEME "Papirus-Dark"  // 或 "Breeze" / "Adwaita"


    // 如果你想强制 GTK4 应用使用深色模式，用这个：
    GTK4_THEME "Adwaita:dark"
    // QT 主题（修正变量名）
    QT_QPA_PLATFORMTHEME "qt5ct"
 

    // 编辑器
    EDITOR "nvim"
    VISUAL "nvim"
}
 
input {
    keyboard {
        xkb {
        }
        repeat-delay 250
        repeat-rate 35
    }
 
    touchpad {
        tap
        natural-scroll
    }
 
    mouse {
        accel-speed -0.15
        accel-profile "flat"
    }
    
    focus-follows-mouse max-scroll-amount="0%"
}
 
// --- 自动启动（修正顺序）---
 
// 1. 优先同步环境变量到 systemd
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME XCURSOR_SIZE"
 
spawn-at-startup "fcitx5"

// 2. 设置深色模式
spawn-sh-at-startup "dconf write /org/gnome/desktop/interface/color-scheme \"'prefer-dark'\""
 
// 3. 重启 Portal（确保应用新配置）
spawn-sh-at-startup "sleep 1 && systemctl --user restart xdg-desktop-portal.service"
 
// 4. 启动 Shell (Noctalia)
spawn-sh-at-startup "qs -c noctalia-shell"
 
// 5. 身份验证代理
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
 
// 6. 其他基础服务
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
spawn-at-startup "~/.config/niri/scripts/screenshot-sound.sh"
spawn-at-startup "xhost" "+si:localuser:root"
spawn-at-startup "systemctl" "--user" "start" "clipsync"
 
// --- 界面设置 ---
hotkey-overlay {
    skip-at-startup
}
 
// 隐藏窗口标题栏
prefer-no-csd
 
// --- 包含子配置文件 ---
include "layout.kdl"
include "animations.kdl"
include "binds.kdl"
include "supertab.kdl"
include "windowrules.kdl"
include "cursor.kdl"
include "outputs.kdl"
 
// 引入 Noctalia 套件配置
include "./noctalia.kdl"
