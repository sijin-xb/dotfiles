//  ██████  ██   ██  ██████  ███████ ██ ███    ██ 
//  ██      ██   ██ ██    ██ ██   ██    ██ ██  ██ 
//  ███████ ███████ ██    ██ ██████  ██ ██ ██  ██ 
//       ██ ██   ██ ██    ██ ██   ██ ██ ██  ██ ██ 
//  ██████  ██   ██  ██████  ██   ██ ██ ██   ████ 
// 这是niri的配置文件，我写了很多注释方便阅读，同时保留了部分英文注释
// 自25.11版本起，niri的配置文件支持了拆分，每一条include都代表把已经拆分出去的配置文件嵌入进来。
include "binds.kdl"
// 由 Hyprland 快捷键迁移而来；冲突项已注释，只含不冲突的新增绑定
include optional=true "binds-hyprland-migrated.kdl"
// 注意：dms/binds.kdl 由 DMS 自己在文件末尾 include（见下方 dms/ 那几行），
// 这里不再重复引入，避免同一文件被加载两遍。
include optional=true "rule.kdl"
include optional=true "output.kdl"
include optional=true "animations.kdl"
include optional=true "layout.kdl"
include optional=true "blur.kdl" 
include optional=true "debug.kdl"
// 截图保存位置
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d %H-%M-%S.png"

// 环境变量

environment {
    LANGUAGE "zh_CN:en"
    LANG "zh_CN.UTF-8"
    // 光标：主题与尺寸的唯一来源是 DMS（DankMaterialShell/settings.json 的
    // cursorSettings → 生成 dms/cursor.kdl）。这里的环境变量必须跟它一致，
    // 否则 Qt、Electron 等读环境变量的程序会和 Wayland 原生程序对不上
    // （LinuxQQ 就是这样）。改主题/尺寸请改 DMS 设置，然后同步这两行。
    XCURSOR_THEME "Matugen-Cursors"
    XCURSOR_SIZE "32"
    // 输入法环境变量（与 Hyprland 的 hyprland/env.lua 保持一致，四个都要有。
    // 原先 niri 这边漏了 GTK_IM_MODULE / QT_IM_MODULE，GTK 与 Qt 程序不会走 fcitx）
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    // Qt 优先 Wayland 文本输入、回退 fcitx；只强制 fcitx 后端会在 QtQuick 里吞按键
    QT_IM_MODULES "wayland;fcitx"
    // qt主题
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    // 解决quickshell图标主题缺失问题
    QS_ICON_THEME "Adwaita"
    // GTK软件使用的渲染器，可以解决n卡双显卡导致的GTK应用启动缓慢问题，AMD或Intel单显卡不需要这行设置可以注释掉
    GSK_RENDERER "gl"
    // 默认文本编辑器
    EDITOR "vim"
    
}
// 光标配置
//
// ⚠ 主题和尺寸不在这里写。它们归 DMS 管（settings.json 的 cursorSettings，
//   生成 dms/cursor.kdl 并在本文件末尾 include），在这里再写一份只会多一个
//   会过期、还会误导人的副本 —— 2026-09-23 清理前这里写的是
//   catppuccin-mocha-flamingo-cursors / 24，而实际生效的是 DMS 的
//   Matugen-Cursors / 32，加上 environment 里第三份 34，一共三处打架。
//   要改主题/尺寸：DMS 设置 → 光标，或直接改 settings.json 再 `dms config`。
cursor {
    // 闲置多少毫秒自动隐藏光标
    hide-after-inactive-ms 15000
    // 晃动鼠标放大光标（shorin-fork 独有；2026-09-26 换回该 fork 后恢复）
    shake-to-enlarge {
	//off
	// 持续晃动时让光标逐步变大（不写就只是直接跳到 zoom-factor 那么大）
	grow
	grow-speed 0.01
        threshold 2000
	hold-duration-ms 1500
	zoom-factor 7
    }
}
 
// 带缩略图的 alt+tab 切换窗口功能（「窗口缩略图切换器」）。
// （2026-09-26 改键）Alt+Tab 是它的正向入口；Super+Tab 不绑任何东西。
// 其余入口：
//   Super+Shift+Tab   反向（本工作区内）
//   Super+grave       同应用内正向（filter="app-id"）
//   Super+Shift+grave 同应用内反向
recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.2
    }

    binds {
        // （2026-09-26）Alt+Tab 归还给窗口切换 —— 它就是这个「窗口缩略图切换器」
        // 的正向入口：按下弹出窗口缩略图列表，松开确认。中途被拿去开过总览和
        // 启动器，现在按需求放回来。
        //   Alt+Tab           正向（MRU 顺序）
        //   Super+Shift+Tab   反向（本工作区内）
        //   Super+grave       同应用内正向
        //   Super+Shift+grave 同应用内反向
        Alt+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// niri 配色：改用 matugen 的产物（原来引用的 colors.kdl 是 9/5 的旧快照，
// 不会随壁纸更新）。recent-windows 等由它提供。
// 注：里面的 screen-cast-picker 已于 2026-09-26 去掉（spicy 无此节点）。
include "matugen-colors.kdl"
// DMS 自动生成的 niri 配色（含 focus-ring / border / shadow / tab-indicator），
// 放在 colors.kdl 之后，同名节点以它为最终取值 —— 边框颜色由此纳入 DMS 配色体系
include "dms/colors.kdl"

input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.
        }

        // Enable numlock on startup, omitting this setting disables it.
        //numlock
	    repeat-delay 250
	    repeat-rate 35
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        // nautural-scroll可以翻转触摸板滚动的方向
        natural-scroll
        //accel-speed -0.5
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        
	// off
        // natural-scroll
        // 鼠标速度
        accel-speed 0
        // 禁用鼠标加速 
        accel-profile "flat"
	// scroll-method "no-scroll"
        //speed of scroll,like:
        //scroll-factor horizontal=2.0 vertical=-5.0 
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    //warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    //focus-follows-mouse max-scroll-amount="50%"
}

//blur
//blur {
	// off
	//passes 3
	//offset 2
	//noise 0.02
	//saturation 1.5 
//}

overview {
	workspace-shadow {
	//off
	}
	//缩放
	zoom 0.55
}
// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more ipawn examples.

// 自动启动设置
// 壁纸链路的最终形态（2026-09-23 实测确认）：
//   · 桌面壁纸     → DMS 的 mpvpaper 插件（视频）
//   · overview 背景 → 同一条视频：mpvpaper 的 surface 在 rule.kdl 里配了
//     place-within-backdrop true，实测总览里能看到视频画面
//   · 兜底         → DMS 主壁纸（namespace "quickshell"）也在 backdrop 里；
//     mpvpaper 插件停掉时它会自动接管，不会开天窗
//   · layout.kdl   → background-color "transparent"（DMS 官方要求）
//
// 已删（2026-09-23）：awww-daemon -n overview + 配套同步脚本。
//   它当初的理由是「DMS 1.7 的命名空间全是 dms: 前缀，不确定 ^quickshell$
//   能不能进 backdrop，拿 awww 兜底」。实测证伪：把 awww 的图换成纯绿后，
//   总览 backdrop 的 5 个采样点颜色逐点相等，说明 backdrop 一直来自 DMS 的
//   quickshell surface，awww 从未参与。它在正常桌面被 mpvpaper 盖住、在总览里
//   又不影响 backdrop，两头都不露脸。附带隐患是同步脚本只在开机时跑一次，
//   之后换壁纸不会跟随。（rule.kdl 里配套的 awww layer-rule 也一并删了。）
//
// 此前试过的几个错路（已废弃，注释备查以防再踩）：
//   · awww-daemon -n overview + 同步脚本：让 awww 接管了 backdrop 画图，
//     不是"纯 DMS"。—— 后来证明它连 backdrop 都没接管上，纯属多画一层。
//   · layer-rule match namespace="^quickshell$" + place-within-backdrop true：
//     当时判断为「方向错」（以为会让 desktop 没壁纸）。实测是对的，而且它是
//     backdrop 真正的来源，现在保留着当兜底。
//   · awww 的 -n X 让命名空间变成 awww-daemonX（X=overview → "awww-daemonoverview"）
//spawn-at-startup "waypaper" "--restore"
// 询问管理员权限功能（身份验证）
// polkit 认证代理 —— DMS 自带 polkit，停掉
//spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// 屏幕分享、录屏相关的环境设置,如果屏幕分享出异常的话可以开启
 spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri LANG LANGUAGE LC_MESSAGES LC_CTYPE"
// GNOME tracker修复
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
// 通知程序 —— DMS 自带通知，停掉避免重复
//spawn-at-startup "mako"
// 任务栏
// 让位给 quickshell：它自带栏，同开会和 waybar 叠成两条。
// 想换回 waybar：把下面 quickshell 那行注释掉、把这行取消注释即可。
//spawn-at-startup "waybar"
// 输入法
// 输入法：与 Hyprland 的 execs.lua 同逻辑 —— 守护启动 → 等就绪 → 激活并切到 rime
// → 把变量推进 dbus/systemd（否则后面拉起的应用拿不到，等于没配）。
// 原来只有一行 `fcitx5`，既没 -d 也没切 rime，所以 niri 下打不出中文。
spawn-at-startup "fcitx5" "-d"
spawn-sh-at-startup "while ! fcitx5-remote --check >/dev/null 2>&1; do sleep 0.1; done; fcitx5-remote -o; fcitx5-remote -s rime; dbus-update-activation-environment --systemd XMODIFIERS GTK_IM_MODULE QT_IM_MODULE QT_IM_MODULES LANG LANGUAGE"
// 剪贴板守护进程
	//cliphist
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
	// wayland <--> x11 剪贴板同步 这个包是我自己推的linuxqq-clipsync-git
spawn-at-startup "systemctl" "--user" "start" "linuxqq-clipsync"
// 闲置时自动熄屏锁屏睡眠的脚本，说实话这东西用处不大，建议用 mod+shift+P 打开电源菜单。
// spawn-at-startup "~/.config/niri/scripts/swayidle.sh"
// 大写锁定键的osd显示 —— DMS 自带 OSD，停掉
//spawn-at-startup "swayosd-server"
// 自动开启护眼模式 —— DMS 自带夜览，停掉
//spawn-at-startup "~/.local/bin/toggle-wlsunset"
// 截图音效的守护进程
spawn-at-startup "~/.config/niri/scripts/screenshot-sound.sh"
// alt+tab切换器（这是一个第三方，无缩略图显示的切换器）
//spawn-at-startup "niriswitcher"
// 已移除的三行（2026-09-23 清理，原因备查）：
//   · spawn-at-startup "~/.local/bin/niri-sidebar" "listen"
//       niri-sidebar 是 end4-pC 那套的侧边栏，DMS 接管后它不再被需要；
//       rule.kdl 里配套的浮动窗口最小尺寸规则也一并删了。
//   · spawn-at-startup "xhost" "+si:localuser:root"
//       让 root 通过用户 XWayland 开窗口，属于放宽 X11 访问权限，非必要不开。
//   · spawn-at-startup "flatpak" "run" "com.github.wwmm.easyeffects" "-w"
//       音频效果器常驻后台，需要时手动开即可，不必开机自启。
// DankMaterialShell（本会话的 shell）
//   `dms run` 同时拉起后端与 UI（见 `dms --help`）。
//   原先这里是 `qs -c end4-pC` —— 那套是 Hyprland 用的 Quickshell 配置，
//   在 niri 上会与 DMS 抢 layer surface，已移除。
spawn-at-startup "dms" "run"
// XSETTINGS 守护进程：XWayland 程序（LinuxQQ 等）靠它读图标/光标主题。
// 之前两边都没启动它，所以 XWayland 程序一直用默认光标。
spawn-at-startup "xsettingsd"
// nirius
spawn-at-startup "niriusd"

spawn-at-startup "wl-clip-persist" "--clipboard" "both"

// 取消启动niri时自动开启快捷键教程
hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
     skip-at-startup
}

// 隐藏窗口标题栏
prefer-no-csd

// 以下两块是 shorin-fork 独有功能（2026-09-26 换回该 fork 后恢复）。
magnifier {
    // off
    zoom-factor 3
    track-cursor false 
    //scale-cursor false
}

grid-overview {
    gap 16
    padding 80
    focused-column-scale 1.04
    grid-all-monitors true
    // 关掉「轻触 Mod 自动开网格总览」这个内建行为：这条即使不写也默认生效，
    // 会和 dms/binds.kdl 里「轻触 Mod → 启动器」冲突（两个一起触发）。
    // 关掉之后轻触 Super 只开启动器。
    default-mod-action false
}

// 手势 / 热角。
// 显式写出来的意义在于自解释：niri 的默认值本来就是「左上角 → overview、
// 左下角 → grid-overview」，所以这一段在行为上等于空操作，但写出来之后
// 既不会被将来 niri 改默认值影响，也不用去翻默认配置猜。
// 可用动作只有 overview 和 grid-overview；某个角写 `off` 可单独关掉。
// 右上 / 右下不写 = 不启用。
gestures {
    hot-corners {
        // 左上角 → 总览
        top-left
        // 左下角 → 网格总览（fork 独有）
        bottom-left { grid-overview; }
    }
}

debug {
	// 放宽聚焦拦截，修复点击托盘程序无法跳转聚焦的问题。
	honor-xdg-activation-with-invalid-serial
}



// DMS Include Configs
include "dms/cursor.kdl"
include "dms/binds.kdl"
include "dms/layout.kdl"
include "dms/windowrules.kdl"
include "dms/input.kdl"
// 外观数值覆盖层：必须排在 dms/layout.kdl 之后，否则被 DMS 的值压掉。
include "override-layout.kdl"
