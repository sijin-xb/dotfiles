layout{
    focus-ring{
        active-gradient from="#c2c8c7cc" to="#c9c5cccc" angle=135
        urgent-color "#ffb4ab"

        }
}
recent-windows {
    highlight {
        active-color "#40403f"
        urgent-color "#ffb4ab"
    }
}
