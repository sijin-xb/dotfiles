layout{
    focus-ring{
        active-gradient from="#efb4e8cc" to="#f6b8a9cc" angle=135
        urgent-color "#ffb4ab"

        }
}
recent-windows {
    highlight {
        active-color "#3e373c"
        urgent-color "#ffb4ab"
    }
}
