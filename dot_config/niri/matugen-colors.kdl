layout{
    focus-ring{
        active-gradient from="#d2bcffcc" to="#ffaedccc" angle=135
        urgent-color "#ffb4ab"

        }
}
recent-windows {
    highlight {
        active-color "#423f46"
        urgent-color "#ffb4ab"
    }
}
