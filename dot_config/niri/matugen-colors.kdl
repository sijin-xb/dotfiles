layout{
    focus-ring{
        active-gradient from="#d1c2d2cc" to="#d4c0d7cc" angle=135
        urgent-color "#ffb4ab"

        }
}
recent-windows {
    highlight {
        active-color "#3b383a"
        urgent-color "#ffb4ab"
    }
}
