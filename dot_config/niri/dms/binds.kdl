// ============================================================================
// DankMaterialShell 功能键位
//
// 目标：与 Hyprland 那套「同一功能、同一键位」对齐，不用重新记键。
// 实现方式：走 `dms ipc call <target> <function>`（目标清单见 `dms ipc`）。
//
// 本文件由 niri 的 config.kdl 通过 include "dms/binds.kdl" 载入。
// ⚠ 若执行 `dms setup binds`，DMS 可能重写本文件 —— 想保留这里的映射，
//   改完记得备份，或改到别的文件里。
// ============================================================================

binds {
    // 启动器 —— 轻触 Super（与 Hyprland 的 Super 单击一致）
    //
    // 「单独一个 Mod」这种只有修饰键的绑定是 shorin-fork 的扩展，本机用的正是
    // 该 fork，所以原生可用。按住 Super 仍是修饰键（Super+Tab 等不受影响），
    // 按下后单独松开才触发。
    // （上游 niri / niri-spicy 不支持它，会报 `invalid key: Mod` 拒绝加载整份
    //   配置。中途为了留在 spicy 试过 keyd 重映射与 mod-tap 补丁，两者都已随
    //   换回 shorin fork 废弃，别再把它们捡回来。）
    Mod repeat=false hotkey-overlay-title="启动器 Launcher" { spawn "dms" "ipc" "call" "launcher" "toggle"; }

    // 备用：Super+Space 同开启动器
    Mod+Space hotkey-overlay-title="启动器 Launcher" { spawn "dms" "ipc" "call" "launcher" "toggle"; }

    // Alt+Tab 归「窗口缩略图切换器」（见 config.kdl 的 recent-windows），不在这里绑。
    // Alt+Tab hotkey-overlay-title="总览 Overview" { toggle-overview; }

    // 通知中心 —— Hyprland 里 Super+N 是右侧栏（通知）
    Mod+N hotkey-overlay-title="通知 Notifications" { spawn "dms" "ipc" "call" "notifications" "toggle"; }

    // 剪贴板 —— 与 Hyprland 的 Super+V 同键
    Mod+V hotkey-overlay-title="剪贴板 Clipboard" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }

    // 设置 —— 与 Hyprland 的 Super+I 同键
    Mod+I hotkey-overlay-title="设置 Settings" { spawn "dms" "ipc" "call" "settings" "toggle"; }

    // 控制中枢 —— Hyprland 的 Super+M 是媒体控制，DMS 里媒体归在控制中枢
    Mod+M hotkey-overlay-title="控制中枢 Control center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }

    // 挂件 —— 与 Hyprland 的 Super+G（挂件浮层）同键
    Mod+G hotkey-overlay-title="挂件 Widgets" { spawn "dms" "ipc" "call" "widget" "toggle"; }

    // 栏开关 —— 与 Hyprland 的 Super+J 同键
    Mod+J hotkey-overlay-title="开关任务栏 Toggle bar" { spawn "dms" "ipc" "call" "bar" "toggle"; }

    // 仪表盘 —— Hyprland 的 Super+B 是左侧栏，DMS 对应的是 dash
    Mod+B hotkey-overlay-title="仪表盘 Dashboard" { spawn "dms" "ipc" "call" "dash" "toggle"; }

    // Hyprland 里 Super+O 与 Super+B 都开左侧栏，这里保持同键同功能
    Mod+O hotkey-overlay-title="仪表盘 Dashboard" { spawn "dms" "ipc" "call" "dash" "toggle"; }

    // 快捷键速查 —— 与 Hyprland 的 Super+/ 同键
    Mod+Slash hotkey-overlay-title="快捷键速查表 Keybinds" { spawn "dms" "ipc" "call" "keybinds" "toggle"; }

    // 电源菜单 —— 与 Hyprland 的 Ctrl+Alt+Delete 同键
    Mod+Ctrl+Delete hotkey-overlay-title="电源菜单 Power menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

    // 取色器 —— 与 Hyprland 的 Super+Shift+C 同键
    // 原先那条是 hyprpicker 的残缺替代命令（grim+slurp），已停用，改由 DMS 承担
    Mod+Shift+C hotkey-overlay-title="取色 Color picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }

    // 锁屏 —— 与 Hyprland 的 Super+L 同键，改用 DMS 锁屏（原为 loginctl）
    Mod+L hotkey-overlay-title="锁屏 Lock" { spawn "dms" "ipc" "call" "lock" "lock"; }

    // 欢迎页 —— Hyprland 里 Super+Shift+Alt+/ 打开 quickshell 欢迎页
    Mod+Shift+Alt+Slash hotkey-overlay-title="欢迎页 Welcome" { spawn "dms" "ipc" "call" "welcome" "open"; }

    // 壁纸选择器 —— Hyprland 里 Ctrl+Super+T 与 Ctrl+Alt+T 都是壁纸选择器
    // Mod+Ctrl+T  保留原来的 DMS 仪表盘壁纸页
    Mod+Ctrl+T hotkey-overlay-title="壁纸管理器 Wallpaper" { spawn "dms" "ipc" "call" "dankdash" "wallpaper"; }
    // Ctrl+Alt+T  改用 wallpaperCarousel 插件（全屏 3D 倾斜轮播挑选器）
    //   插件需先在「DMS 设置 → Plugins」里启用，且 DMS 要接管壁纸管理。
    //   键盘：← → 切换，Enter 应用，Esc 关闭。
    //   想换回仪表盘那版，把这行 spawn 改回：
    //   spawn "dms" "ipc" "call" "dankdash" "wallpaper"
    Ctrl+Alt+T hotkey-overlay-title="壁纸轮播 Wallpaper carousel" { spawn "dms" "ipc" "wallpaperCarousel" "toggle"; }

    // 轮播内切换上/下一张（不必先打开，会自动打开并高亮）
    Ctrl+Alt+Right hotkey-overlay-title="下一张壁纸 Next wallpaper" { spawn "dms" "ipc" "wallpaperCarousel" "cycleNext"; }
    Ctrl+Alt+Left  hotkey-overlay-title="上一张壁纸 Prev wallpaper" { spawn "dms" "ipc" "wallpaperCarousel" "cyclePrevious"; }

    // 随机壁纸 —— Hyprland 里 Ctrl+Super+Alt+T
    Mod+Ctrl+Alt+T hotkey-overlay-title="随机壁纸 Random wallpaper" { spawn "dms" "ipc" "call" "wallpaper" "next"; }

    // 录屏 —— quickCapture 插件。同一个键再按一次停止（recordToggle）。
    //   想改成选区录制，把 screen 换成 region；走 xdg-desktop-portal 用 portal。
    //   注意：本机没装 gpu-screen-recorder，只有 wf-recorder（CPU 后端），
    //   按插件文档 wf-recorder 只录画面、不带声音；要声音得装 gpu-screen-recorder。
    Ctrl+Alt+R hotkey-overlay-title="录屏 Record screen" { spawn "dms" "ipc" "call" "quickCapture" "recordToggle" "screen"; }
}
