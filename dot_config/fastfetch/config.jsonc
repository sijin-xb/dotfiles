{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "CachyOS_small",
        "type": "auto",
        "color": {
            "1": "#ffb3b1",
            "2": "#ffb3b1"
        },
        "padding": {
            "top": 2,
            "left": 3,
            "right": 6
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "title": "#f0dedd",
            "output": "#d7c1c0"
        }
    },
    "modules": [
        "break",
        {
          "type": "custom",
          "format": "\u001b[92m┌──────────────󰋊 Hardware󰋊──────────────┐"
        },
        {
          "type": "host",
          "key": " PC",
          "keyColor": "green"
        },
        {
          "type": "memory",
          "key": "│ ├󰍛",
          "keyColor": "green"
        },
        {
          "type": "disk",
          "key": "│ ├󰋊",
          "keyColor": "green",
          "format": "{1} / {2} ({3})"
        },
        {
          "type": "cpu",
          "key": "│ ├󰍙",
          "keyColor": "green",
          "format": "{1}, {3} Cores"
        },
        {
          "type": "gpu",
          "key": "│ └󰍛",
          "keyColor": "green",
          "format": "{2}, {3}"
        },
        {
          "type": "custom",
          "format": "\u001b[92m└──────────────────────────────────────┘"
        },
        "break",
        {
          "type": "custom",
          "format": "\u001b[93m┌──────────────󰻠 System󰻠───────────────┐"
        },
        {
          "type": "os",
          "key": " OS",
          "keyColor": "yellow",
          "format": "{name}"
        },
        {
          "type": "wm",
          "key": "│ ├󰉲",
          "keyColor": "yellow"
        },
        {
          "type": "de",
          "key": "│ ├󰧭",
          "keyColor": "yellow"
        },
        {
          "type": "kernel",
          "key": "│ └󰣠",
          "keyColor": "yellow"
        },
        {
          "type": "custom",
          "format": "\u001b[93m└──────────────────────────────────────┘"
        },
        "break",
        {
          "type": "custom",
          "format": "\u001b[94m┌──────────────󰔎 Theme󰔎────────────────┐"
        },
        {
          "type": "shell",
          "key": " sh",
          "keyColor": "blue",
          "format": "{1}"
        },
        {
          "type": "wmtheme",
          "key": "│ ├󰉼",
          "keyColor": "blue"
        },
        {
          "type": "terminal",
          "key": "│ ├󰆍",
          "keyColor": "blue",
          "format": "{1}"
        },
        {
          "type": "packages",
          "key": "│ └󰏖",
          "keyColor": "blue"
        },
        {
          "type": "custom",
          "format": "\u001b[94m└──────────────────────────────────────┘"
        },
        "break",
        {
          "type": "custom",
          "format": "\u001b[95m┌──────────────󰚭 Times󰚭───────────────┐"
        },
        {
          "type": "command",
          "key": "  OS Age ",
          "keyColor": "magenta",
          "keyWidth": 12,
          "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
          "type": "uptime",
          "key": "  Uptime ",
          "keyColor": "magenta"
        },
        {
          "type": "custom",
          "format": "\u001b[95m└──────────────────────────────────────┘"
        },
        "break",
        {
          "type": "custom",
          "format": "\u001b[96m┌──────────────󰚭 Music󰚭───────────────┐"
        },
        {
          "type": "command",
          "key": "  󰎆 Now ",
          "keyColor": "cyan",
          "keyWidth": 12,
          "text": "playerctl metadata --format \"$(printf '%s%sartist%s%s - %s%stitle%s%s' '{' '{' '}' '}' '{' '{' '}' '}')\" 2>/dev/null || echo 'Not Playing'"
        },
        {
          "type": "command",
          "key": "  󰎅 Album ",
          "keyColor": "cyan",
          "keyWidth": 12,
          "text": "playerctl metadata --format \"$(printf '%s%salbum%s%s' '{' '{' '}' '}')\" 2>/dev/null || echo '-'"
        },
        {
          "type": "command",
          "key": "  󰎄 Source ",
          "keyColor": "cyan",
          "keyWidth": 12,
          "text": "playerctl --format \"$(printf '%s%splayerName%s%s' '{' '{' '}' '}')\" status 2>/dev/null || echo '-'"
        },
        {
          "type": "custom",
          "format": "\u001b[96m└──────────────────────────────────────┘"
        },
        "break"
    ]
}
