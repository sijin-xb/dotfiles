layout{
    focus-ring{
        active-color "#d2bcffcc"
        urgent-color "#ffb4ab"

        }
    border {
        active-color "#d2bcff"
        inactive-color "#948f99"
        urgent-color "#ffb4ab"
    }
    tab-indicator {
        active-color "#d2bcff"
        inactive-color "#948f99"
        urgent-color "#ffb4ab"
    }
    insert-hint {
        color "#d2bcff80"
    }
    shadow {
        color "#00000070"
    }
}
recent-windows {
    highlight {
        active-color "#423f46"
        urgent-color "#ffb4ab"
    }
}
// 内置screencast portal选择器的配色（shorin-fork 独有，2026-09-26 换回后恢复）
screen-cast-picker {
    background-color "#26232a"
    accent-color "#d2bcff"
    text-color "#f9f2fc"
    accent-text-color "#2b0068"
}
