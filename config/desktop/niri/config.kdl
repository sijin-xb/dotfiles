include "binds.kdl"
include optional=true "binds-hyprland-migrated.kdl"
include optional=true "rule.kdl"
include optional=true "output.kdl"
include optional=true "animations.kdl"
include optional=true "layout.kdl"
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d %H-%M-%S.png"

environment {
    LANGUAGE "zh_CN:en"
    LANG "zh_CN.UTF-8"
    "_JAVA_AWT_WM_NONREPARENTING" "1"
    XCURSOR_THEME "Matugen-Cursors"
    XCURSOR_SIZE "24"
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    QT_IM_MODULES "wayland;fcitx"
    QT_QPA_PLATFORMTHEME "xdgdesktopportal"
    QT_STYLE_OVERRIDE "kvantum"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QS_ICON_THEME "WhiteSur-dark"
    GSK_RENDERER "gl"
    EDITOR "vim"
    DMS_SCREENSHOT_DIR "/home/xibie/Pictures/Screenshots/Niri-screenshots"

}
cursor {
    hide-after-inactive-ms 15000
    shake-to-enlarge {
	grow
	grow-speed 0.01
        threshold 2000
	hold-duration-ms 1500
	zoom-factor 7
    }
}

recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.2
    }

    binds {
        Mod+grave       hotkey-overlay-title="同应用下一个窗口 Next window (same app)" { next-window     filter="app-id"; }
        Mod+Shift+grave hotkey-overlay-title="同应用上一个窗口 Previous window (same app)" { previous-window filter="app-id"; }
    }
}

include "matugen-colors.kdl"

input {
    keyboard {
        xkb {

        }

	    repeat-delay 250
	    repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {

        accel-speed 0
        accel-profile "flat"
    }

    trackpoint {
    }

}

overview {
	workspace-shadow {
	}
	zoom 0.55
}

 spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri LANG LANGUAGE LC_MESSAGES LC_CTYPE"
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
spawn-sh-at-startup "systemctl --user unset-environment HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD HYPRCURSOR_THEME HYPRCURSOR_SIZE DESKTOP_SESSION XDG_MENU_PREFIX UWSM_FINALIZE_VARNAMES UWSM_WAIT_VARNAMES ELECTRON_OZONE_PLATFORM_HINT DCONF_PROFILE COSMIC_VERSION; systemctl --user set-environment XDG_CURRENT_DESKTOP=niri XDG_SESSION_DESKTOP=niri DESKTOP_SESSION=niri"

spawn-sh-at-startup "$HOME/.config/scripts/session-wallpaper-isolation.sh niri"
spawn-at-startup "fcitx5" "-d"
spawn-sh-at-startup "while ! fcitx5-remote --check >/dev/null 2>&1; do sleep 0.1; done; fcitx5-remote -o; fcitx5-remote -s rime; dbus-update-activation-environment --systemd XMODIFIERS GTK_IM_MODULE QT_IM_MODULE QT_IM_MODULES LANG LANGUAGE"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-sh-at-startup "mkdir -p \"$HOME/Pictures/Screenshots/Niri-screenshots\""
spawn-at-startup "dms" "run"
spawn-sh-at-startup "while [ ! -S /tmp/.X11-unix/X0 ]; do sleep 0.2; done; exec xsettingsd"
spawn-at-startup "niriusd"

hotkey-overlay {
     skip-at-startup
}

prefer-no-csd

magnifier {
    zoom-factor 3
    track-cursor false 
}

grid-overview {
    gap 16
    padding 80
    grid-all-monitors true
    default-mod-action false
}

gestures {
    hot-corners {
        top-left
        bottom-left { grid-overview; }
    }
}

debug {
	honor-xdg-activation-with-invalid-serial
}

include "dms/cursor.kdl"
include "dms/binds.kdl"
include "dms/layout.kdl"
include optional=true "blur.kdl"
include "dms/windowrules.kdl"
include "dms/input.kdl"
include "override-layout.kdl"
include optional=true "nyxuri-windows.kdl"

spawn-at-startup "bash" "-c" "systemctl --user import-environment XDG_MENU_PREFIX && kbuildsycoca6"
