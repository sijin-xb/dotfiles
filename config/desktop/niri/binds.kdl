
binds {

    Super+Slash hotkey-overlay-title="快捷键教程 Keybind tutorial" { spawn "~/.config/niri/scripts/niri-binds"; }

    Mod+Alt+W hotkey-overlay-title="切换壁纸 Change wallpaper" { spawn "dms" "ipc" "call" "dankdash" "wallpaper"; }
    Mod+F10 hotkey-overlay-title="随机切换壁纸 Random wallpaper" { spawn "dms" "ipc" "call" "wallpaper" "next"; }
    Mod+Shift+F10 hotkey-overlay-title="随机下载动漫壁纸 Random download anime wallpaper" {spawn "~/.config/scripts/random-anime-wallpaper.sh";}
    Mod+F1 hotkey-overlay-title="开关输入法 Toggle fcitx" {spawn-sh "pkill fcitx5 || fcitx5 -d";}

    Mod+Ctrl+G hotkey-overlay-title="切换工作区时自动跟随 Follow when switch workspaces" {spawn "nirius" "toggle-follow-mode" ;} 
    Mod+Shift+Q hotkey-overlay-title="快速聚焦到QQ Quick focus QQ" {spawn "nirius" "focus" "--app-id" "QQ" ;} 
    Mod+Shift+O hotkey-overlay-title="快速聚焦到OpenCode Quick focus OpenCode" {spawn "nirius" "focus" "--app-id" "opencode" ;} 

    Mod+Alt+WheelScrollUp hotkey-overlay-title="滚轮放大屏幕 magnifier"  { adjust-magnifier-zoom 0.2; }
    Mod+Alt+WheelScrollDown hotkey-overlay-title="滚轮缩小屏幕 magnifier" { adjust-magnifier-zoom -0.2; }
    Mod+Shift+Z  hotkey-overlay-title="切换屏幕缩放效果 magnifier" { toggle-magnifier; }

    Mod+Alt+O hotkey-overlay-title="AI助手 opencode agent" { spawn "kitty" "--class" "opencode" "-e" "opencode"; }        

    Mod+T hotkey-overlay-title="共享终端 Terminal" { spawn "kitty" "--single-instance"; }
    Mod+return hotkey-overlay-title="独立终端 Terminal" { spawn "kitty"; }
    Mod+Alt+E hotkey-overlay-title="文档管理器 File manager" {spawn "env" "GSK_RENDERER=gl" "nautilus" "--new-window";}
    Mod+Alt+L hotkey-overlay-title="锁屏 Lock screen" { spawn-sh "hyprlock -c ~/.config/niri/hyprlock.conf"; } 
    Mod+P hotkey-overlay-title="提取窗口信息 Pick information" { spawn "~/.config/niri/scripts/niri-pick" "focus"; }
    Mod+Alt+V hotkey-overlay-title="剪贴板 Clipboard" repeat=false {spawn-sh "kitty --single-instance --class cliphist-tui -e cliphist-tui";} // Use spawn-sh to run a shell command. Do this if you need pipes, multiple commands, etc.

    Alt+Shift+F4  hotkey-overlay-title="强制杀死窗口以及关联进程 Force kill -9 a window tree" repeat=false { spawn "~/.config/niri/scripts/niri-force-kill-window" "-f"; }

    Mod+MouseMiddle  hotkey-overlay-title="中键关闭窗口 Close window (middle click)" { close-window; }

    Mod+Home hotkey-overlay-title="聚焦第一列 Focus first column" { focus-column-first; }
    Mod+End  hotkey-overlay-title="聚焦最后一列 Focus last column" { focus-column-last; }
    Mod+Ctrl+Home hotkey-overlay-title="整列移到最前 Move column to first" { move-column-to-first; }
    Mod+Ctrl+End  hotkey-overlay-title="整列移到最后 Move column to last" { move-column-to-last; }

    Mod+Ctrl+Page_Down hotkey-overlay-title="整列移到下个工作区 Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up hotkey-overlay-title="整列移到上个工作区 Move column to prev workspace"  { move-column-to-workspace-up; }

    Mod+Shift+WheelScrollDown  hotkey-overlay-title="切换工作区 Change workspaces"    cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title="切换工作区 Change workspaces" cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title="滚轮把整列移到下个工作区 Move column to next workspace" cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   hotkey-overlay-title="滚轮把整列移到上个工作区 Move column to prev workspace" cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollDown   hotkey-overlay-title="滚轮切换聚焦 Change focus with wheel"   { focus-column-right; }
    Mod+WheelScrollUp        hotkey-overlay-title="滚轮切换聚焦 Change focus with wheel" { focus-column-left; }
    Mod+Ctrl+WheelScrollDown hotkey-overlay-title="滚轮右移整列 Move column right with wheel" { move-column-right; }
    Mod+Ctrl+WheelScrollUp   hotkey-overlay-title="滚轮左移整列 Move column left with wheel" { move-column-left; }

    Mod+BracketLeft  hotkey-overlay-title="向左移动窗口 Move window to left between columes" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="向右移动窗口 Move window to right between columes" { consume-or-expel-window-right; }
    Mod+MouseForward hotkey-overlay-title="鼠标侧键聚焦上一个窗口 Focus window up (mouse side button)" { focus-window-up; }
    Mod+MouseBack    hotkey-overlay-title="鼠标侧键聚焦下一个窗口 Focus window down (mouse side button)" { focus-window-down; }

    Mod+R  hotkey-overlay-title="按预设切换宽度 Switch width " { switch-preset-column-width; }

    Mod+Ctrl+R hotkey-overlay-title="重置窗口高度 Reset window height" { reset-window-height; }

    Mod+Ctrl+F hotkey-overlay-title="整列撑满剩余宽度 Expand column to available width" { expand-column-to-available-width; }

    Mod+Backslash hotkey-overlay-title="居中当前列 Center column" { center-column; }

    Mod+Ctrl+C hotkey-overlay-title="居中可见列 Center visible columns" { center-visible-columns; }

    Mod+Shift+Minus hotkey-overlay-title="窗口高度-5% Shrink window height" { set-window-height "-5%"; }
    Mod+Shift+Equal hotkey-overlay-title="窗口高度+5% Grow window height" { set-window-height "+5%"; }

    Mod+Shift+V hotkey-overlay-title="浮动/平铺切换 Toggle floating" { switch-focus-between-floating-and-tiling; }

    Mod+Alt+N hotkey-overlay-title="浮动/平铺切换 Toggle floating" { switch-focus-between-floating-and-tiling; }

    Print            hotkey-overlay-title="区域截图+标注 Region screenshot (mark-shot)" { spawn "mark-shot"; }
    Ctrl+Print       hotkey-overlay-title="全屏截图 Full screen"       { screenshot-screen show-pointer=false; }
    Alt+Print        hotkey-overlay-title="聚焦窗口 Focus-window screenshot" { screenshot-window show-pointer=false; }

    Mod+Escape hotkey-overlay-title="开关快捷键抑制 Toggle shortcuts inhibit" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E hotkey-overlay-title="退出niri Quit niri" { quit; }
}
