layout{
    focus-ring{
        active-gradient from="{{colors.primary.default.hex}}cc" to="{{colors.tertiary.default.hex}}cc" angle=135
        urgent-color "{{colors.error.default.hex}}"

        }
    border {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
    shadow {
        color "{{colors.shadow.default.hex}}70"
    }
}
recent-windows {
    highlight {
        active-color "{{colors.surface_bright.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
// 内置screencast portal选择器的配色（shorin-fork 独有，2026-09-26 换回后恢复）
screen-cast-picker {
    background-color "{{colors.surface_container.default.hex}}"
    accent-color "{{colors.primary.default.hex}}"
    text-color "{{colors.on_surface.default.hex}}"
    accent-text-color "{{colors.on_primary.default.hex}}"
}
