# micro 配色 —— 由 matugen 从壁纸生成，请勿手改。
# 取值与 kitty / fuzzel / walker / GTK 同一份 M3 色板（MD3 语义）：
#   表面  → surface_container_*      文字 → on_surface / on_surface_variant
#   关键字 → primary                 函数 → secondary
#   字符串 → tertiary                错误 → error
color-link default "{{colors.on_surface.default.hex}},{{colors.surface_container_lowest.default.hex}}"
color-link comment "{{colors.outline.default.hex}}"

color-link identifier "{{colors.on_surface.default.hex}}"
color-link identifier.class "{{colors.secondary.default.hex}}"
color-link identifier.var "{{colors.on_surface.default.hex}}"

color-link constant "{{colors.tertiary.default.hex}}"
color-link constant.number "{{colors.tertiary.default.hex}}"
color-link constant.string "{{colors.tertiary.default.hex}}"

color-link symbol "{{colors.on_surface_variant.default.hex}}"
color-link symbol.brackets "{{colors.on_surface_variant.default.hex}}"
color-link symbol.tag "{{colors.primary.default.hex}}"

color-link type "{{colors.secondary.default.hex}}"
color-link type.keyword "{{colors.primary.default.hex}}"
color-link type.extended "default"

color-link special "{{colors.tertiary.default.hex}}"
color-link statement "{{colors.primary.default.hex}}"
color-link preproc "{{colors.primary.default.hex}}"

color-link underlined "{{colors.secondary.default.hex}}"
color-link error "bold {{colors.error.default.hex}}"
color-link todo "bold {{colors.tertiary.default.hex}}"

color-link diff-added "{{colors.tertiary.default.hex}}"
color-link diff-modified "{{colors.secondary.default.hex}}"
color-link diff-deleted "{{colors.error.default.hex}}"

color-link gutter-error "{{colors.error.default.hex}}"
color-link gutter-warning "{{colors.tertiary.default.hex}}"

color-link statusline "{{colors.on_surface.default.hex}},{{colors.surface_container_high.default.hex}}"
color-link tabbar "{{colors.on_surface_variant.default.hex}},{{colors.surface_container.default.hex}}"
color-link indent-char "{{colors.outline_variant.default.hex}}"
color-link line-number "{{colors.outline.default.hex}}"
color-link current-line-number "{{colors.on_surface.default.hex}}"

color-link cursor-line "{{colors.surface_container_low.default.hex}}"
color-link color-column "{{colors.surface_container_low.default.hex}}"

# 选中区与搜索高亮：底用 container 档，字保持高对比前景色
color-link selection "{{colors.on_surface.default.hex}},{{colors.secondary_container.default.hex}}"
color-link hlsearch "{{colors.on_surface.default.hex}},{{colors.tertiary_container.default.hex}}"
