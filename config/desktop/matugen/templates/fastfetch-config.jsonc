{
    "logo": {
        "source": "CachyOS_small",
        "type": "auto",
        "color": {
            "1": "{{colors.primary.default.hex}}",
            "2": "{{colors.primary.default.hex}}"
        },
        "padding": {
            "top": 2,
            "left": 3,
            "right": 6
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "title": "{{colors.on_surface.default.hex}}",
            "output": "{{colors.on_surface_variant.default.hex}}"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m┌──────────── 󰋊 Hardware 󰋊 ────────────┐",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "board",
            "key": " MB",
            "format": "{1} {3}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "cpu",
            "key": "│ ├󰍙",
            "format": "{1}, {3} Cores",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "gpu",
            "key": "│ ├󰨄",
            "format": "{2}, {3}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "swap",
            "key": "│ ├󰓅",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "disk",
            "key": "│ └󰋊",
            "format": "{1} / {2} ({3})",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m└──────────────────────────────────────┘",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m┌───────────── 󰻠 System 󰻠 ─────────────┐",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "os",
            "key": " OS",
            "format": "{name}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "kernel",
            "key": "│ ├󰣠",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "wm",
            "key": "│ ├󰉲",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "shell",
            "key": "│ ├󰆍",
            "format": "{1}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "uptime",
            "key": "│ └󰔚",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m└──────────────────────────────────────┘",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m┌───────────── 󰔎 Theme 󰔎 ──────────────┐",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "theme",
            "key": " GTK",
            "format": "{2}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻",
            "format": "{2}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "font",
            "key": "│ ├󰛖",
            "format": "{2}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "cursor",
            "key": "│ └󰇀",
            "format": "{theme} ({size}px)",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m└──────────────────────────────────────┘",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m┌──────────── 󰚭 Session 󰚭 ─────────────┐",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "datetime",
            "key": " Now",
            "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "command",
            "key": "│ ├ OS Age",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "loadavg",
            "key": "│ ├󰓅",
            "format": "{1} {2} {3}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "processes",
            "key": "│ └󰒣",
            "format": "{1} procs, {2} threads",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m└──────────────────────────────────────┘",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        "break",
        {
            "type": "command",
            "key": " ",
            "text": "busctl --user list --no-pager 2>/dev/null | grep -qF org.mpris.MediaPlayer2. || exit 0; printf '\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m┌───────────── 󰎆 Music 󰎆 ──────────────┐\\n'",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "media",
            "key": " 󰎆 Now",
            "format": "{title} — {artist}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "media",
            "key": "│ ├󰎅",
            "format": "{album}",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "media",
            "key": "│ └󰎄",
            "format": "{player-name} [{status}]",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "command",
            "key": " ",
            "text": "busctl --user list --no-pager 2>/dev/null | grep -qF org.mpris.MediaPlayer2. || exit 0; printf '\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m└──────────────────────────────────────┘\\n'",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        "break"
    ]
}
